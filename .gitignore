# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
.obsidian/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.pnpm-store/
dist/
.turbo/

# Claude / AI
.claude/audit.log
.claude/sessions/
# per-user local config — never commit (#435)
.claude/settings.local.json

# Terraform / OpenTofu
# Provider/module cache — can be hundreds of MB; never commit (a 686MB AWS
# provider .exe under a module's .terraform/ once blocked a push).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Keep .terraform.lock.hcl committed — it pins provider versions.

# Local secrets — never commit
.env
.env.local
*.local
