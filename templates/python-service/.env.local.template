# 1Password CLI references per ADR-0006 §2.
# Run with: op run --env-file=.env.local.template -- <command>
#
# Real values live in 1Password vault "{{project_name}}". This file is committed
# (it contains references, not secrets); .env.local (with real values) is NEVER committed.

# Application secrets
SENTRY_DSN=op://{{project_name}}/dev/sentry_dsn
SENTRY_AUTH_TOKEN=op://{{project_name}}/dev/sentry_auth_token

# OpenTelemetry endpoint (per ADR-0009)
OTEL_EXPORTER_OTLP_ENDPOINT=op://{{project_name}}/dev/otel_exporter_otlp_endpoint

# Grafana (for terraform apply with grafana provider)
GRAFANA_URL=op://{{project_name}}/dev/grafana_url
GRAFANA_API_KEY=op://{{project_name}}/dev/grafana_api_key

# Database (when applicable)
DATABASE_URL=op://{{project_name}}/dev/database_url

# Add other secrets as project needs them
