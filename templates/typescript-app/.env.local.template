# 1Password CLI references per ADR-0006 §2.
# Run with: op run --env-file=.env.local.template -- pnpm dev
#
# Real values live in 1Password vault "{{project_name}}". This file is committed
# (it contains references, not secrets); .env.local (with real values) is NEVER committed.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (per ADR-0009)
NEXT_PUBLIC_SENTRY_DSN=op://{{project_name}}/dev/sentry_dsn
SENTRY_AUTH_TOKEN=op://{{project_name}}/dev/sentry_auth_token
SENTRY_ORG=op://{{project_name}}/dev/sentry_org
SENTRY_PROJECT=op://{{project_name}}/dev/sentry_project

# OpenTelemetry endpoint (per ADR-0009)
OTEL_EXPORTER_OTLP_ENDPOINT=op://{{project_name}}/dev/otel_exporter_otlp_endpoint
OTEL_SERVICE_NAME={{project_slug}}

# Database (Drizzle + Postgres)
DATABASE_URL=op://{{project_name}}/dev/database_url

# GitHub (for the user-feedback endpoint per Standard 11)
GITHUB_REPO_OWNER={{github_username}}
GITHUB_REPO_NAME={{project_name}}
GITHUB_TOKEN=op://{{project_name}}/dev/github_token_for_feedback

# AWS SES (for user-feedback auto-reply per Standard 11; optional)
AWS_REGION=us-east-1
SES_FROM_EMAIL=op://{{project_name}}/dev/ses_from_email

# Cloudflare Turnstile (optional, opt-in per Standard 11)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=op://{{project_name}}/dev/turnstile_site_key
TURNSTILE_SECRET_KEY=op://{{project_name}}/dev/turnstile_secret_key
